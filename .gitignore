# ==========================================================
# Java / Maven
# ==========================================================
# 编译产物
target/
classes/
out/
bin/
*.class
*.jar
*.war

# 日志（各模块 logs/ 目录）
logs/
*.log

# ==========================================================
# 密钥与凭据（重要）
# ==========================================================
# JWT 签名密钥库 —— 泄露即可伪造任意用户身份。
# 注意必须写 *.jks（带点），写成 *jks 匹配不到 .jks 文件！
*.jks
*.keystore
*.p12
*.pem
*.pfx

# 环境变量与本地配置
.env
.env.*
!.env.example

# ==========================================================
# IDE
# ==========================================================
.idea/
*.iml
*.iws
*.ipr
.vscode/
.settings/
.project
.classpath
.factorypath

# ==========================================================
# 操作系统
# ==========================================================
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini

# ==========================================================
# 数据与运行产物
# ==========================================================
# Agent 对话记录（含真实用户对话，可能含手机号/地址）。
# 实际路径由 campus-agent/src/main/resources/application.yml 的
# agent.session.root-dir 指定，默认 D:/JavaProject/261005/UserContext
UserContext/
**/UserContext/

# 上传的图片（由 campus-item 的 hm.image.root-dir 指定，不入库）
itemImage/

# 临时文件
*.tmp
*.swp
*~

# ==========================================================
# 刻意不忽略（需入库）
# ==========================================================
# nacos/    —— 网关路由等配置，需入库供他人导入
# sql/      —— 建库脚本
# *.yaml    —— 配置模板（敏感值请用 ${ENV:默认值} 占位）
# LICENSE.txt / README.md